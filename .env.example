# Seeker Bot — Environment Variables
# Copy to .env and fill in values

BOT_TOKEN=your_telegram_bot_token_here

# Database
DATABASE_URL=postgresql+asyncpg://seeker:seeker_dev_pass@postgres:5432/seeker_bot

# Redis
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Ticket API keys (optional)
YANDEX_AFISHA_API_KEY=
KASSIR_API_KEY=

# Admin
ADMIN_IDS=

# Telegram Mini App
TMA_URL=https://your-tma-domain.com
TMA_SECRET=your_tma_secret_key
