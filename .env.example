# Seeker Bot — Environment Variables
# Copy to .env and fill in values

# Telegram Bot Token (обязательно)
# Получить: https://t.me/BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel ID (для публициста)
# Например: @channel_username или -1001234567890
PUBLISHER_CHANNEL_ID=

# Database (PostgreSQL)
# Для Docker Compose: postgresql+asyncpg://seeker:seeker_dev_pass@postgres:5432/seeker_bot
# Для прода: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://seeker:seeker_dev_pass@postgres:5432/seeker_bot

# Redis (кэш + брокер Celery)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Ticket API keys (опционально)
YANDEX_AFISHA_API_KEY=
KASSIR_API_KEY=

# Admin — Telegram IDs администраторов (JSON-список)
# Пример: [123456789, 987654321]
ADMIN_IDS=[]

# Telegram Mini App — URL фронтенда
TMA_URL=http://localhost:5173
TMA_SECRET=

# PostgreSQL password (для продакшена)
POSTGRES_PASSWORD=seeker_prod_pass
